# Godot 4+ specific ignores
.godot/
.import/
export.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# System/tool-specific ignores
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/

# Exported game files (except the HTML wrapper)
web/*.pck
web/*.wasm
web/*.js
web/*.png
web/*.worker.js
web/*.audio.worklet.js

# Keep the HTML template
!web/index.html
!web/README.md
!web/.gitkeep
